# ============================================================================
# Configuración de Entorno para Plesk/IONOS - WaterCRM
# ============================================================================
#
# Este archivo contiene una plantilla de configuración optimizada para
# despliegue en Plesk/IONOS.
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env: cp .env.plesk .env
# 2. Edita .env con tus valores reales
# 3. NUNCA subas .env a GitHub (ya está en .gitignore)
#
# ============================================================================

# ----------------------------------------------------------------------------
# APLICACIÓN
# ----------------------------------------------------------------------------

APP_NAME=WaterCRM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm-prueba.test
APP_DOMAIN=crm-prueba.test

# SSL/HTTPS - Activar en producción con certificado SSL
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# En producción, usar 'daily' para rotar logs automáticamente
# Niveles: debug, info, notice, warning, error, critical, alert, emergency

# ----------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL
# ----------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=watercrm_production
DB_USERNAME=watercrm_user
DB_PASSWORD=

# IMPORTANTE: Configura estos valores en Plesk:
# 1. Ve a "Bases de datos" → "Agregar base de datos"
# 2. Tipo: PostgreSQL
# 3. Nombre: watercrm_production (o el que prefieras)
# 4. Usuario: watercrm_user
# 5. Genera una contraseña segura y pégala arriba

# ----------------------------------------------------------------------------
# DRIVERS Y CACHÉ
# ----------------------------------------------------------------------------

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Opciones para caché si Plesk tiene Redis:
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

# ----------------------------------------------------------------------------
# REDIS (si está disponible en Plesk)
# ----------------------------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Si Plesk no tiene Redis, déjalo así (no afectará la app)

# ----------------------------------------------------------------------------
# MEMCACHED (si está disponible)
# ----------------------------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.es
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@crm-prueba.test"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración SMTP de IONOS:
# - MAIL_HOST: smtp.ionos.es
# - MAIL_PORT: 587 (TLS) o 465 (SSL)
# - MAIL_USERNAME: tu email completo (ej: info@tu-dominio.com)
# - MAIL_PASSWORD: contraseña de tu email
# - MAIL_ENCRYPTION: tls (para puerto 587) o ssl (para puerto 465)
#
# Configura el email en Plesk → "Correo" → "Crear dirección de correo"

# ----------------------------------------------------------------------------
# AWS S3 (si quieres almacenar archivos en la nube)
# ----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Deja vacío si no usas S3. Laravel usará storage local.

# ----------------------------------------------------------------------------
# PUSHER (WebSockets en tiempo real)
# ----------------------------------------------------------------------------

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# Si no usas Pusher, déjalo vacío

# ----------------------------------------------------------------------------
# VITE (Build de Assets)
# ----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ----------------------------------------------------------------------------
# GOOGLE MAPS API (Geolocalización)
# ----------------------------------------------------------------------------

GOOGLE_MAPS_API_KEY=

# Para obtener una API key:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto
# 3. Activa "Maps JavaScript API" y "Geocoding API"
# 4. Crea credenciales → API Key
# 5. Restringe la key a tu dominio

# ----------------------------------------------------------------------------
# CONFIGURACIÓN DE INSTALACIONES (Geofencing)
# ----------------------------------------------------------------------------

# Radio en metros para validar instalaciones
INSTALLATION_RADIUS=100

# Aumenta este valor si las instalaciones deben permitir más distancia
# desde la ubicación del cliente

# ----------------------------------------------------------------------------
# CONFIGURACIÓN DE IMÁGENES
# ----------------------------------------------------------------------------

# Tamaños en KB
MAX_IMAGE_SIZE=2048
MAX_LOGO_SIZE=512

# Formatos permitidos (separados por coma)
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ----------------------------------------------------------------------------
# EMAIL INTERNO
# ----------------------------------------------------------------------------

INTERNAL_EMAIL_ENABLED=true
SMTP_DRIVER=smtp

# ----------------------------------------------------------------------------
# SEGURIDAD
# ----------------------------------------------------------------------------

# Rate limiting (solicitudes por minuto)
THROTTLE_LIMIT=60
THROTTLE_DECAY=1

# Session
SESSION_DOMAIN=.crm-prueba.test
SESSION_SAME_SITE=lax

# Cookies
SANCTUM_STATEFUL_DOMAINS=crm-prueba.test,*.crm-prueba.test

# ----------------------------------------------------------------------------
# MULTI-TENANCY
# ----------------------------------------------------------------------------

# Configuración para tenancy (subdominios)
TENANCY_DOMAIN=crm-prueba.test

# Si usas subdominios de tenants (ej: cliente1.crm-prueba.test)
# asegúrate de configurar wildcard DNS en Plesk

# ----------------------------------------------------------------------------
# BACKUP Y MANTENIMIENTO
# ----------------------------------------------------------------------------

# Zona horaria
APP_TIMEZONE=Europe/Madrid

# Locale
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ----------------------------------------------------------------------------
# NOTAS IMPORTANTES PARA PLESK
# ----------------------------------------------------------------------------

# 1. PERMISOS:
#    storage/ debe tener permisos 775
#    bootstrap/cache/ debe tener permisos 775
#
#    Ejecuta: chmod -R 775 storage bootstrap/cache
#
# 2. DOCUMENT ROOT:
#    Debe apuntar a /httpdocs/public
#
# 3. EXTENSIONES PHP REQUERIDAS:
#    - pgsql, pdo_pgsql
#    - mbstring, openssl, tokenizer
#    - xml, ctype, json, bcmath
#    - gd (para procesamiento de imágenes)
#    - curl, zip
#
#    Habilítalas en: Plesk → Sitios web y dominios → Configuración PHP
#
# 4. PHP VERSION:
#    Mínimo 8.2, recomendado 8.3
#
# 5. MEMORY LIMIT:
#    Recomendado: 256M o superior
#
# 6. DESPUÉS DE CONFIGURAR .env:
#    php artisan key:generate
#    php artisan migrate --force
#    php artisan config:cache
#    php artisan route:cache
#    php artisan view:cache
#
# 7. PARA AUTO-DEPLOYMENT:
#    - Configura el webhook en GitHub (ver PLESK_SETUP.md)
#    - Edita public/deploy.php con tu SECRET
#    - Asegúrate que deploy.sh es ejecutable: chmod +x deploy.sh
#
# ============================================================================
